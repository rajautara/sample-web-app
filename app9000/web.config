<?xml version="1.0" encoding="utf-8"?>
<!-- Site IIS: app9000, binding http/*:9000, folder C:\inetpub\app9000 -->
<!-- Tukar path Python dan nama AD group mengikut server anda -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\Python312\python.exe"
                  arguments="C:\inetpub\app9000\app.py"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\app9000\logs\python.log"
                  startupTimeLimit="60"
                  forwardWindowsAuthToken="true">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\app9000" />
        <!-- Group AD yang boleh buka /admin -->
        <environmentVariable name="ADMIN_GROUP" value="TSIDSG\WebApp-Admins" />
      </environmentVariables>
    </httpPlatform>

    <!-- Perlu unlock dulu dengan appcmd (sekali sahaja per server) -->
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
